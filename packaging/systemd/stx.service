[Unit]
Description=stx v3 task daemon
Documentation=https://github.com/phansen314/stx
After=default.target
# Avoid tight restart loops (e.g. transient lock/port conflict). These are [Unit]-section
# directives — systemd silently ignores them under [Service].
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# One-time build required first: (cd %h/code/stx && ./gradlew installDist)
ExecStart=%h/code/stx/build/install/stx/bin/stx
Restart=on-failure
RestartSec=2s
# A JVM killed by SIGTERM exits 143 (128+15) even though its shutdown hook ran cleanly —
# stopping the server, draining the write actor, releasing the lock. Without this, EVERY clean
# `systemctl stop` records "Failed with result 'exit-code'", which makes `is-failed` lie and
# would camouflage a real crash. Fixing it here rather than calling exitProcess(0) from the hook:
# exiting from inside a shutdown hook can deadlock against the shutdown it is running in.
SuccessExitStatus=143
# Optional overrides — uncomment to change:
# Environment=STX_PORT=8420
# Environment=XDG_STATE_HOME=%h/.local/state

[Install]
WantedBy=default.target
