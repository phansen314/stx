#!/usr/bin/env bash
# stx launcher — runs the Go CLI (bin/stx-go), building it on first use if missing.
# Symlink this onto your PATH if you like: ln -s "$PWD/bin/stx" ~/.local/bin/stx
set -euo pipefail
self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(cd "$(dirname "$self")/.." && pwd)"
bin="$here/bin/stx-go"
if [ ! -x "$bin" ]; then
  echo "stx: building the Go client (first run)…" >&2
  # Stamp the version the same way Makefile's `go` target does, or a first-run binary reports
  # "dev" forever. Inlined rather than shelling out to make: this launcher must work with nothing
  # installed but Go.
  v="$(git -C "$here" describe --tags --always --dirty 2>/dev/null || echo dev)"
  ( cd "$here" && go build -ldflags "-X github.com/phansen314/stx/internal/version.Version=$v" -o bin/stx-go ./cmd/stx )
fi
exec "$bin" "$@"
